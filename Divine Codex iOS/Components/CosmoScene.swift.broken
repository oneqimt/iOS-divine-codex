//
//  CosmoScene.swift
//  Divine Codex iOS
//
//  The full-screen immersive RealityKit Cosmology Explorer.
//
//  Phase 1 focus: Clean data-driven scene + smooth camera focus on node selection.
//  Selection and focus are driven by ExplorerViewModel.selectedNode.
//
//  NOTE: You may see the following harmless RealityKit console messages in DEBUG:
//    - "Could not locate file 'default-binaryarchive.metallib' in bundle."
//    - "asset string 'engine:throttleGhosted.rematerial' parse failed..."
//  These are internal RealityKit engine messages when using pure code-generated content
//  (SimpleMaterial + primitives, no bundled .usdz or precompiled shaders). They are
//  non-fatal and do not affect rendering or behavior. Safe to ignore during development.

// MARK: - The 24 Invisibles (Definition)
//
// The 24 Invisibles are twelve sacred syzygies (divine masculine + feminine pairs)
// that dwell in the 13th Aeon, also called the Region of Righteousness.
// They represent perfect divine balance and are a core part of the Gnostic
// cosmology we are visualizing in this scene.
//
// In our current model they will eventually live under the "Aeon" layer
// (specifically the 13th Aeon), with Barbelo and Sophia being two of the
// most important individual emanations we surface from Sanity data.

import SwiftUI
import RealityKit
import simd

struct CosmoScene: View {

    /// The explorer view model containing the combined local + server nodes.
    /// Passed in from ExplorerView so we have access to the built node list.
    let explorerViewModel: ExplorerViewModel

    /// Access to server data (DivineCodex entries for Barbelo, Sophia, etc.)
    @Environment(SanityViewModel.self) private var sanity

    // References to key entities so we can perform hit testing from gestures.
    @State private var rootEntity: Entity?
    @State private var cameraEntity: Entity?

    /// Maps node IDs to their corresponding RealityKit entities.
    /// This lets us animate, highlight, or focus specific nodes during selection.
    @State private var nodeEntities: [String: Entity] = [:]

    // MARK: - Camera Animation State (Phase 1 - simple & tunable)

    /// Default overview camera position (used when nothing is focused).
    /// Tuned to frame the current local hierarchy (Monad high, Pleroma, Aeon low).
    private let defaultCameraPosition = SIMD3<Float>(0, 11, 30)

    /// Default look-at point for the overview.
    private let defaultCameraLookAt = SIMD3<Float>(0, 9, 0)

    /// Current target position the camera is animating toward.
    @State private var cameraTargetPosition: SIMD3<Float>?

    /// Current target look-at point the camera is animating toward.
    @State private var cameraTargetLookAt: SIMD3<Float>?

    /// When true, the camera animation system is allowed to run.
    /// We keep this off on initial entry so the starting view is stable.
    /// It only becomes active when the user selects a node or explicitly returns to overview.
    @State private var isCameraAnimating = false

    /// Used to ignore the very first `.onChange` of `selectedNode` that fires on view appearance
    /// (which would otherwise immediately call `returnToOverview` and start animation).
    @State private var hasReceivedInitialSelectionChange = false

    // MARK: - Highlight / Emphasis State (Visual feedback for focused node)

    /// The entity currently receiving visual emphasis.
    @State private var highlightedEntity: Entity?

    /// The target scale we are animating the highlighted entity toward.
    @State private var targetHighlightScale: Float = 1.0

    /// Screen-space positions for node labels (updated every frame).
    /// Key = node.id, Value = CGPoint in the view's coordinate space.
    @State private var labelScreenPositions: [String: CGPoint] = [:]

    /// Used to dismiss the fullScreenCover from inside the immersive experience.
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        ZStack(alignment: .topTrailing) {
            // Main immersive content (full bleed)
            // Using black background for now to better evaluate Liquid Glass effects
            ZStack {
                Color.black.ignoresSafeArea()

                Group {
                    if RealityKitSupport.isSupported {
                        GeometryReader { geometry in
                            ZStack {
                                RealityView { content in
                                // ============================================================
                                // DIAGNOSTIC BLOCK - REMOVE AFTER WE FIX VISIBILITY
                                // ============================================================
                                print("🟢 [CosmoScene] RealityView make closure STARTED")
                                print("🟢 [CosmoScene] explorerViewModel.nodes.count = \(explorerViewModel.nodes.count)")

                                for node in explorerViewModel.nodes {
                                    print("   → Node: \(node.name)  id=\(node.id)  hasExplorer=\(node.explorer != nil)")
                                }
                                // ============================================================

                                // Root entity for the entire cosmology scene
                                let root = Entity()
                                root.name = "CosmologyRoot"

                                // Improved lighting for visibility during development.
                                // Using two DirectionalLights instead of AmbientLight for maximum compatibility.
                                let keyLight = DirectionalLight()
                                keyLight.light.intensity = 2000
                                keyLight.position = [0, 18, 8]
                                keyLight.look(at: [0, 8, 0], from: keyLight.position, relativeTo: nil)
                                root.addChild(keyLight)

                                let fillLight = DirectionalLight()
                                fillLight.light.intensity = 900
                                fillLight.position = [2, 6, -14]
                                fillLight.look(at: [0, 8, 0], from: fillLight.position, relativeTo: nil)
                                root.addChild(fillLight)

                                // Create entities from the current ExplorerNode data (local + Sanity)
                                // Only nodes with explorer visuals are rendered in Phase 1.
                                var entityMap: [String: Entity] = [:]

                                for node in explorerViewModel.nodes {
                                    if let entity = makeEntity(for: node) {
                                        root.addChild(entity)
                                        entityMap[node.id] = entity
                                        print("   ✅ Created entity for: \(node.name)")
                                    } else {
                                        print("   ⚠️  Skipped (no explorer visuals): \(node.name)")
                                    }
                                }

                                print("🟢 [CosmoScene] Total entities added from data: \(entityMap.count)")

                                // TEMPORARY SAFETY NET: If we created zero entities, drop a big bright test sphere
                                // so we can prove the RealityView pipeline is working.
                                if entityMap.isEmpty {
                                    print("🔴 [CosmoScene] ZERO entities from data — injecting bright test sphere")
                                    let testMesh = MeshResource.generateSphere(radius: 1.5)
                                    let testMaterial = UnlitMaterial(color: .systemRed)
                                    let testEntity = ModelEntity(mesh: testMesh, materials: [testMaterial])
                                    testEntity.position = [0, 8, 0]
                                    root.addChild(testEntity)
                                }

                                content.add(root)

                                // Controllable camera entity — we own this for focus animations
                                let camera = PerspectiveCamera()
                                camera.position = defaultCameraPosition
                                camera.look(at: defaultCameraLookAt,
                                            from: defaultCameraPosition,
                                            relativeTo: nil)
                                content.add(camera)

                                // Smooth camera animation + highlight + label positioning subscription.
                                // Runs every frame.
                                content.subscribe(to: SceneEvents.Update.self) { _ in
                                    animateCameraStep(camera: camera)
                                    animateHighlight()
                                    updateLabelScreenPositions(camera: camera, viewSize: geometry.size)
                                }

                                // Store references on main to avoid mutating state during make
                                DispatchQueue.main.async {
                                    rootEntity = root
                                    cameraEntity = camera
                                    nodeEntities = entityMap

                                    // Do NOT set camera targets here on first load.
                                    // The camera is already positioned via look(at:) above.
                                    // Animation only starts when the user taps a node.
                                }
                            }
                            .gesture(
                                SpatialTapGesture()
                                    .onEnded { value in
                                        let tapLocation = value.location
                                        handleTap(at: tapLocation, in: geometry.size)
                                    }
                            )

                                // 2D Labels overlay (will be populated once we finish the projection)
                            }
                        }
                    } else {
                       // UnsupportedRealityKitView()
                    }
                }
            }
            .ignoresSafeArea()

            // Dismiss button (always available, respects safe area)
            closeButton
                .padding(.top, 8)
                .padding(.trailing, 20)
                .safeAreaPadding(.top)
        }
        .onAppear {
            explorerViewModel.didEnterImmersiveScene()

            // Debug logging for data flow (can be removed later)
            print("Sanity codices count: \(sanity.codices.count)")
            print("ExplorerViewModel nodes count: \(explorerViewModel.nodes.count)")
        }
        .onDisappear {
            explorerViewModel.didExitImmersiveScene()
            cameraTargetPosition = nil
            cameraTargetLookAt = nil
            isCameraAnimating = false
            hasReceivedInitialSelectionChange = false

            // Reset highlight state
            highlightedEntity = nil
            targetHighlightScale = 1.0

            // Force all entities back to normal scale on exit (safety)
            for entity in nodeEntities.values {
                entity.scale = [1, 1, 1]
            }
        }
        .onChange(of: explorerViewModel.selectedNode) { oldValue, newNode in
            // On the very first change we receive after the view appears, we may get
            // the initial `nil` → `nil` presentation value. We want to ignore that
            // specific case so we don't immediately call returnToOverview() on entry.
            // Any subsequent change (including the first real user selection) should be processed.
            if !hasReceivedInitialSelectionChange {
                hasReceivedInitialSelectionChange = true

                // Only swallow the change if it is the pure initial nil presentation.
                if oldValue == nil && newNode == nil {
                    updateHighlight(for: nil)
                    return
                }
            }

            if let node = newNode {
                focusOnNode(node)
            } else {
                returnToOverview()
            }

            updateHighlight(for: newNode)
        }
    }
    }

    // MARK: - Close Button

    private var closeButton: some View {
        Button {
            explorerViewModel.didExitImmersiveScene()
            dismiss()
        } label: {
            Image(systemName: "xmark")
                .font(.system(size: 15, weight: .semibold))
                .foregroundStyle(Theme.Colors.primaryText.opacity(0.85))
                .padding(11)
                .background(.ultraThinMaterial, in: Circle())
                .overlay {
                    Circle()
                        .stroke(Theme.Colors.primaryText.opacity(0.12), lineWidth: 1)
                }
        }
        .accessibilityLabel("Close Cosmology Explorer")
    }

    // MARK: - Entity Creation

    /// Creates a RealityKit entity for an ExplorerNode when it has valid visualization data.
    /// Returns nil for nodes that should not be rendered visually in the current phase.
    private func makeEntity(for node: ExplorerNode) -> Entity? {
        guard let visuals = node.explorer else {
            // No explorer visuals defined (common for dynamic Sanity emanations in Phase 1)
            return nil
        }

        let radius: Float = (visuals.scale ?? 1.0) * 0.5

        let mesh: MeshResource = switch visuals.geometryHint {
        case "sphere", "light":   .generateSphere(radius: radius)
        case "octahedron":        .generateBox(size: radius * 1.4)
        case "icosahedron":       .generateSphere(radius: radius)
        case "torus":             .generateSphere(radius: radius) // placeholder until we add real torus
        default:                  .generateSphere(radius: radius)
        }

        // Using UnlitMaterial during early development so objects are self-illuminating
        // and guaranteed visible regardless of light direction. We can switch back to
        // physically-based materials later.
        let material = UnlitMaterial(color: colorFromHex(visuals.colorHex) ?? .white)

        let entity = ModelEntity(mesh: mesh, materials: [material])
        entity.name = node.id
        entity.position = visuals.worldPosition

        // Attach component for hit testing / reverse lookup
        entity.components.set(NodeIdentifierComponent(nodeId: node.id))

        // Collision for raycasting
        entity.components.set(CollisionComponent(shapes: [.generateSphere(radius: radius * 1.25)]))

        return entity
    }

    private func colorFromHex(_ hex: String?) -> UIColor? {
        guard let hex = hex else { return nil }
        var hexSanitized = hex.trimmingCharacters(in: .whitespacesAndNewlines)
        hexSanitized = hexSanitized.replacingOccurrences(of: "#", with: "")

        var rgb: UInt64 = 0
        guard Scanner(string: hexSanitized).scanHexInt64(&rgb) else { return nil }

        let r = CGFloat((rgb & 0xFF0000) >> 16) / 255.0
        let g = CGFloat((rgb & 0x00FF00) >> 8) / 255.0
        let b = CGFloat(rgb & 0x0000FF) / 255.0

        return UIColor(red: r, green: g, blue: b, alpha: 1.0)
    }

    // MARK: - Hit Testing

    private func handleTap(at location: CGPoint, in viewSize: CGSize) {
        guard let root = rootEntity,
              let camera = cameraEntity else {
            return
        }

        // Generate a world-space ray from the tap location through the camera.
        let (origin, direction) = makeRayVectors(from: location, viewSize: viewSize, camera: camera)

        guard let scene = root.scene else {
            print("Scene not yet available for hit testing")
            return
        }

        // Perform raycast against collision shapes in the scene.
        let hits = scene.raycast(
            origin: origin,
            direction: direction,
            length: 1000,
            query: .nearest
        )

        // Find the first hit that corresponds to one of our explorer nodes.
        for hit in hits {
            if let component = hit.entity.components[NodeIdentifierComponent.self],
               let node = explorerViewModel.nodes.first(where: { $0.id == component.nodeId }) {

                if let current = explorerViewModel.selectedNode {
                    // We are currently in a focused / zoomed state.
                    // Per your request: tapping *any* node (including a different one)
                    // while focused should first exit back to the default overview state.
                    // This will be important once we have manual panning.
                    if current.id == node.id {
                        // Re-tapping the focused node → toggle off (deselect)
                        explorerViewModel.clearSelection()
                        print("— Deselected via re-tap on focused node: \(node.name)")
                    } else {
                        // Tapping a different node while focused → exit focus mode first.
                        // We intentionally do *not* select the new node on this tap.
                        explorerViewModel.clearSelection()
                        print("— Exiting focus mode (tapped different node while focused): \(node.name)")
                    }
                } else {
                    // Not currently focused → normal selection
                    explorerViewModel.selectNode(node)
                    print("✓ Selected via 3D tap: \(node.name) (id: \(node.id))")
                }
                return
            }
        }

        // Tapped empty space — clear selection.
        explorerViewModel.clearSelection()
        print("— Cleared selection (tapped empty space)")
    }

    /// Creates a ray (origin + direction) in world space from a screen tap location using the given camera.
    private func makeRayVectors(from point: CGPoint, viewSize: CGSize, camera: Entity) -> (origin: SIMD3<Float>, direction: SIMD3<Float>) {
        // Normalize tap to NDC (-1 to +1)
        let x = (Float(point.x) / Float(viewSize.width)) * 2 - 1
        let y = 1 - (Float(point.y) / Float(viewSize.height)) * 2   // flip Y

        // Approximate field of view (we can make this more precise later by reading the actual camera projection).
        let fov: Float = .pi / 3.0   // ~60 degrees
        let aspect = Float(viewSize.width / viewSize.height)
        let tanHalfFov = tan(fov / 2)

        // Direction in camera space
        var direction = SIMD3<Float>(
            x * tanHalfFov * aspect,
            y * tanHalfFov,
            -1.0
        )

        direction = simd_normalize(direction)

        // Transform direction into world space using the camera's orientation
        let worldDirection = camera.orientation.act(direction)
        let origin = camera.position

        return (origin: origin, direction: worldDirection)
    }

    // MARK: - Camera Focus & Animation (Phase 1 - simple & tunable)

    /// Moves the camera to nicely frame the given node with a smooth animation.
    /// The framing offset is intentionally simple so it can be felt and adjusted.
    private func focusOnNode(_ node: ExplorerNode) {
        guard let visuals = node.explorer else {
            print("⚠️ Cannot focus on \(node.name) — no explorer visuals")
            return
        }

        // Improved Phase 1 focus framing:
        // Instead of adding a large vertical offset to the node (which sends the camera
        // high up when focusing on lower nodes), we use a more stable "dolly in" style.
        // Camera height stays relatively consistent with the overview, and we mainly
        // move forward on Z while centering the look-at on the selected node.
        let focusDistance: Float = 18.0     // how far back from the node on Z
        let cameraHeight: Float = 11.5      // relatively stable height (close to overview)
        let lookAtLift: Float = 1.8         // look a bit above the node center

        let targetPosition = SIMD3<Float>(
            visuals.worldPosition.x,
            cameraHeight,
            visuals.worldPosition.z + focusDistance
        )

        let targetLookAt = visuals.worldPosition + SIMD3<Float>(0, lookAtLift, 0)

        cameraTargetPosition = targetPosition
        cameraTargetLookAt = targetLookAt
        isCameraAnimating = true

        print("→ Focusing camera on: \(node.name)")
        print("   targetPosition: \(targetPosition)")
        print("   targetLookAt:   \(targetLookAt)")
        print("   current camera: \(cameraEntity?.position ?? .zero)")
    }

    /// Returns the camera to the default overview position with a smooth animation.
    private func returnToOverview() {
        cameraTargetPosition = defaultCameraPosition
        cameraTargetLookAt = defaultCameraLookAt
        isCameraAnimating = true

        print("← Returning camera to overview")
    }

    // MARK: - Visual Emphasis (Highlighting the focused node)

    /// Updates which entity should receive visual emphasis based on the current selection.
    /// Only the currently focused node gets emphasis; all others remain at their default state.
    private func updateHighlight(for node: ExplorerNode?) {
        // When switching focus (or clearing), immediately reset the previous node
        // back to default scale. This ensures only the newly clicked node ever shows
        // the emphasis, while everything else stays exactly as it appears in the
        // default overview. This will feel more correct once we add panning.
        if let oldEntity = highlightedEntity {
            oldEntity.scale = [1, 1, 1]
        }

        guard let node = node,
              let entity = nodeEntities[node.id] else {
            highlightedEntity = nil
            targetHighlightScale = 1.0
            return
        }

        highlightedEntity = entity
        targetHighlightScale = 1.65   // Nice, noticeable but not overwhelming emphasis
    }

    /// Smoothly animates the scale of the currently highlighted entity toward its target scale.
    /// Called every frame from the SceneEvents.Update subscription.
    private func animateHighlight() {
        guard let entity = highlightedEntity else { return }

        let currentScale = entity.scale.x   // We assume uniform scaling
        let newScale = simd_mix(currentScale, targetHighlightScale, 0.12)

        entity.scale = SIMD3<Float>(repeating: newScale)

        // Optional: once we're back at 1.0 and the target is 1.0, clear the reference
        if targetHighlightScale == 1.0 && abs(newScale - 1.0) < 0.01 {
            highlightedEntity = nil
        }
    }

    // MARK: - 2D Label Positioning (Overlay)

    /// Projects world positions of nodes into screen space so we can render
    /// `NodeLabelView`s as a 2D overlay on top of the RealityView.
    private func updateLabelScreenPositions(camera: Entity, viewSize: CGSize) {
        var newPositions: [String: CGPoint] = [:]

        for (id, entity) in nodeEntities {
            // Only create labels for nodes that have explorer visuals
            guard let node = explorerViewModel.nodes.first(where: { $0.id == id }),
                  node.explorer != nil else { continue }

            let worldPos = entity.position

            if let screenPos = worldToScreen(worldPos, camera: camera, viewSize: viewSize) {
                // Raise the label above the node a bit
                let verticalOffset: CGFloat = -52
                newPositions[id] = CGPoint(x: screenPos.x, y: screenPos.y + verticalOffset)
            }
        }

        DispatchQueue.main.async {
            self.labelScreenPositions = newPositions
        }
    }

    /// Basic world-to-screen projection for the custom PerspectiveCamera.
    private func worldToScreen(_ worldPosition: SIMD3<Float>,
                               camera: Entity,
                               viewSize: CGSize) -> CGPoint? {
        let cameraPos = camera.position
        let toPoint = worldPosition - cameraPos

        // Transform into camera space
        let cameraOrientation = camera.orientation
        let local = cameraOrientation.inverse.act(toPoint)

        // Discard points behind the camera
        guard local.z < 0 else { return nil }

        // Approximate perspective projection (~60° vertical FOV)
        let fov: Float = .pi / 3.0
        let aspect = Float(viewSize.width / viewSize.height)
        let tanHalfFov = tan(fov / 2.0)

        let x = (local.x / (-local.z)) / (tanHalfFov * aspect)
        let y = (local.y / (-local.z)) / tanHalfFov

        // Convert NDC [-1, 1] to screen coordinates
        let screenX = (x + 1.0) * 0.5 * Float(viewSize.width)
        let screenY = (1.0 - y) * 0.5 * Float(viewSize.height)

        return CGPoint(x: CGFloat(screenX), y: CGFloat(screenY))
    }

    /// Performs one step of camera interpolation toward the current target.
    /// Called every frame via SceneEvents.Update.
    private func animateCameraStep(camera: Entity) {
        guard isCameraAnimating else { return }
        guard let targetPos = cameraTargetPosition,
              let targetLook = cameraTargetLookAt else { return }

        let currentPos = camera.position
        let distance = simd_length(targetPos - currentPos)

        // Stop animating once we're very close to avoid micro-drift and fighting
        if distance < 0.15 {
            isCameraAnimating = false
            return
        }

        // Simple exponential smoothing on position (feels nice and contemplative).
        let positionDamping: Float = 0.075
        let newPos = simd_mix(currentPos, targetPos, SIMD3<Float>(repeating: positionDamping))
        camera.position = newPos

        // Use RealityKit's built-in look(at:) for correct orientation.
        // This respects the engine's camera conventions (looks down -Z).
        // We accept instant orientation update per frame for now — it's reliable
        // and avoids the previous custom matrix bugs that caused nodes to disappear.
        camera.look(at: targetLook, from: newPos, relativeTo: nil)
    }

    /// Creates a transform that orients an entity to look from one point toward another.
    private func lookAt(from: SIMD3<Float>, to: SIMD3<Float>, up: SIMD3<Float>) -> Transform {
        let forward = simd_normalize(to - from)
        let right = simd_normalize(simd_cross(up, forward))
        let newUp = simd_cross(forward, right)

        var matrix = matrix_identity_float4x4
        matrix.columns.0 = SIMD4<Float>(right, 0)
        matrix.columns.1 = SIMD4<Float>(newUp, 0)
        matrix.columns.2 = SIMD4<Float>(forward, 0)
        matrix.columns.3 = SIMD4<Float>(from, 1)

        return Transform(matrix: matrix)
    }
}

// MARK: - Node Identifier Component

/// Lightweight component attached to RealityKit entities so we can
/// map them back to ExplorerNode IDs during hit testing and focus operations.
struct NodeIdentifierComponent: Component {
    let nodeId: String
}

// MARK: - Unsupported Fallback

private struct UnsupportedRealityKitView: View {
    var body: some View {
        VStack(spacing: 24) {
            Image(systemName: "exclamationmark.triangle")
                .font(.system(size: 60))
                .foregroundStyle(Theme.Colors.divineGold)

            Text("Cosmology Explorer Unavailable")
                .font(Theme.Fonts.heroTitle)
                .foregroundStyle(Theme.Colors.primaryText)

            Text(RealityKitSupport.unsupportedMessage)
                .font(Theme.Fonts.body)
                .foregroundStyle(Theme.Colors.secondaryText)
                .multilineTextAlignment(.center)
                .padding(.horizontal, 40)
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity)
        .background(Theme.Colors.background)
    }
}

