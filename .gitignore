# Xcode
#
# Enhanced .gitignore for better Git + Xcode coexistence
# Especially useful when doing git work in terminal while Xcode is open

## === High-priority user & workspace state (most common source of "modified by another app" warnings) ===
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/xcschemes/xcschemamanagement.plist
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

## === Build artifacts & caches ===
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

## === Secrets & Sensitive Data (CRITICAL) ===
# Never commit API keys, tokens, or secret files
secret.swift
secrets.swift
*secret*.swift
*token*.swift
*apikey*.swift
*credentials*.swift
SanityToken.swift
SanitySecrets.swift

# Common secret file patterns
.env
.env.local
.env.*.local
*.pem
*.key
*Secrets.plist
*Credentials.plist

## === Legacy Xcode user files (pre-Xcode 9) ===
*.xcscmblueprint
*.xccheckout
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

## === Old per-user files (very old Xcode) ===
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcuserstate

## === Swift Package Manager ===
.build/
.swiftpm/
.swiftpm/configuration
.swiftpm/xcode/package.xcworkspace/
Package.resolved

## === Dependency managers ===
Pods/
Carthage/Build/
Carthage/Checkouts/

## === Fastlane ===
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## === Code injection / development tools ===
iOSInjectionProject/

## === macOS / general ===
.DS_Store
*.moved-aside
*.symbols
*AppStoreConnect*

## === Playgrounds ===
timeline.xctimeline
playground.xcworkspace

## === Archives & distribution ===
*.xcarchive

# Note: If you use XcodeGen or Tuist in the future, you may want to ignore
# the generated .xcodeproj and .xcworkspace folders (except for shared data).
